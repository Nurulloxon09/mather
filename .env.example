# Optional: your own Desmos API key (the public demo key is used otherwise)
NEXT_PUBLIC_DESMOS_API_KEY=

# Database (README → Database). Leave all empty locally to use a SQLite file in .data/.
# Neon / Postgres (Vercel's Neon integration sets this for you):
DATABASE_URL=
# Or Turso:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Reading uploaded files (README → Uploads). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model to use instead of gemini-flash-latest
GEMINI_MODEL=

# Optional: lock the whole app behind a passcode
APP_PASSCODE=
